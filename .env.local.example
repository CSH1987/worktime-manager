# 선택 설정 — 비워 두면 기본값으로 동작합니다. 필요할 때만 `.env.local` 로 복사해 쓰세요.
# (비밀값 없음: 저장소는 Netlify 위에서 Netlify Blobs 가 자동 연결됩니다)

# 1 이면 서버 없이 인메모리 예시 데이터로 화면만 미리보기
NEXT_PUBLIC_USE_MOCK=

# Netlify 밖(next dev / next start)에서 쓸 로컬 저장 폴더. 기본값: .data/worktime
WORKTIME_DATA_DIR=

# Netlify Blobs 저장소 이름(빌드 때 고정). 기본값: worktime. 시험용 임시 배포는 worktime-test
WORKTIME_BLOB_STORE=

# file 이면 Netlify 위에서도 Blobs 대신 로컬 파일 저장소를 강제(시험용)
WORKTIME_STORE=

# ---- 캘린더 연동 · 백업 (Netlify 환경변수에 넣는다. 값은 git 에 넣지 않는다) ----
# 캘린더 자격증명 암호화 키(32자 이상 아무 난수). 바꾸면 기존 연결이 모두 끊긴다. 발급: openssl rand -base64 48
WORKTIME_TOKEN_KEY=
# 구글 OAuth 클라이언트(웹 애플리케이션). 발급처: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
#   승인된 리디렉션 URI: https://team-worktime.netlify.app/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 백업 내보내기·복구·관리자 연결 해제용 비밀 토큰(16자 이상)
WORKTIME_EXPORT_TOKEN=
# (선택) 구글 리디렉션 주소의 기준 주소. 비우면 요청 주소를 쓴다
WORKTIME_PUBLIC_URL=
# (선택) 전체 연결 수 상한. 기본 30
WORKTIME_MAX_CONNECTIONS=
# (선택) 앞으로의 일정 대량 삭제 보류를 잠깐 풀 때만 1 (끝나면 비움). 지난 일정은 이 값과 상관없이 지우지 않는다
WORKTIME_ALLOW_MASS_DELETE=
