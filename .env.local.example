# Supabase 연결 정보 — 이 파일을 복사해 `.env.local` 로 만들고 값을 채우세요.
# (Vercel 에서는 같은 이름으로 Project → Settings → Environment Variables 에 입력)
# 값 위치: Supabase 대시보드 → Project Settings → API Keys
#   Project URL                          → NEXT_PUBLIC_SUPABASE_URL
#   anon 키 또는 sb_publishable_... 키    → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# 이 두 값은 브라우저에 노출되어도 되는 공개 키입니다.
# service_role / sb_secret_... 키는 절대 여기에 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 접근 방식 — 비워 두면 "링크만 알면 누구나" (공개 모드)
#   1 로 두면 로그인한 사람만 사용 (로그인 모드). DB 에서 supabase/login-mode.sql 도 실행해야 함.
NEXT_PUBLIC_REQUIRE_LOGIN=
