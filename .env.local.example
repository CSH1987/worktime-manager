# Supabase 연결 정보 — 이 파일을 복사해 `.env.local` 로 만들고 값을 채우세요.
# (Vercel 에서는 같은 이름으로 Project → Settings → Environment Variables 에 입력)
# 값 위치: Supabase 대시보드 위쪽 Connect 버튼 (키는 Project Settings → API Keys 에도 있음)
#   Project URL                    → NEXT_PUBLIC_SUPABASE_URL
#   Publishable key (sb_publishable_…) → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   (예전 이름 NEXT_PUBLIC_SUPABASE_ANON_KEY 도 인식하지만, eyJ… 로 시작하는
#    레거시 anon 키는 2026년 말 종료되므로 publishable 키를 쓰세요)
#
# 이 값들은 브라우저에 노출되어도 되는 공개 값입니다.
# sb_secret_… / service_role 키는 절대 여기에 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 접근 방식 — 비워 두면 "링크만 알면 누구나" (공개 모드)
#   1 로 두면 로그인한 사람만 사용 (로그인 모드). DB 에서 supabase/login-mode.sql 도 실행해야 함.
NEXT_PUBLIC_REQUIRE_LOGIN=
